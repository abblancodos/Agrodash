{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, process_id, ts, level, source, message, data, user_id\n        FROM process_logs\n        WHERE process_id = $1\n          AND ($2::timestamptz IS NULL OR ts > $2)\n          AND ($3::text IS NULL OR level = $3)\n          AND ($4::text IS NULL OR source = $4)\n        ORDER BY ts DESC\n        LIMIT $5\n        ",
