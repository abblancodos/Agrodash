  "query": "\n        SELECT c.user_id AS \"user_id: Uuid\", c.role, c.added_at,\n               u.email, u.display_name\n        FROM experiment_collaborators c\n        JOIN users u ON u.id = c.user_id\n        WHERE c.experiment_id = $1\n        ORDER BY c.added_at\n        ",
