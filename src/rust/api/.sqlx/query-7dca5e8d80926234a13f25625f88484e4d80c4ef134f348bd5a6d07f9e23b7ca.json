  "query": "\n        INSERT INTO users (email, display_name, password_hash, role, must_change_pw)\n        VALUES ($1, $2, '', $3, false)\n        ON CONFLICT (email) DO UPDATE\n            SET display_name = EXCLUDED.display_name\n        RETURNING id AS \"id: uuid::Uuid\", email, display_name, role\n        ",
