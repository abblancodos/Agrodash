{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, pipeline_id, ts, raw, filtered, p_diag, decision, actuator, scope_values\n        FROM process_readings\n        WHERE process_id = $1\n          AND ($2::text IS NULL OR pipeline_id = $2)\n          AND ($3::timestamptz IS NULL OR ts >= $3)\n          AND ($4::timestamptz IS NULL OR ts <= $4)\n        ORDER BY ts DESC\n        LIMIT $5\n        ",
