{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, process_id, ts, linea, estado, modo,\n               triggered_by, kalman_convergido, kalman_x_hat, context\n        FROM process_valve_events\n        WHERE process_id = $1\n          AND ($2::timestamptz IS NULL OR ts > $2)\n          AND ($3::text IS NULL OR linea = $3)\n        ORDER BY ts DESC\n        LIMIT $4\n        ",
